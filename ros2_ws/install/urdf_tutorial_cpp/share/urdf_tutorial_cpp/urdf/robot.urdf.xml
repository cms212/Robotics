<?xml version="1.0"?>
<robot name="arm_robot">
  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size = "0.18 0.13 0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <geometry>
        <box size = "0.035 0.035 0.05"/>
      </geometry>
    </visual>
  </link>

<joint name="joint1" type="continuous">
  <parent link="base_link"/>
  <child link="link1"/>
  <axis xyz="0 0 1"/>
  <origin xyz="0 0 .05" rpy="0 0 3.14159"/>
</joint>

<link name="link2">
    <visual>
      <origin xyz="0 0 0.0575" rpy="0 0 0"/>
      <geometry>
        <box size = "0.03 0.04 0.115"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
  <parent link="link1"/>
  <child link="link2"/>
  <axis xyz="0 1 0"/>
  <limit effort="1000.0" lower="1.372" upper="2.667" velocity="0.5"/>
  <origin xyz="0 0 0.025" rpy="3.14159 0 3.14159"/>
</joint>

<link name="link3">
    <visual>
      <origin xyz=".03 0 0" rpy="0 0 0"/>
      <geometry>
        <box size = "0.06 0.04 0.02"/>
      </geometry>
    </visual>
  </link>

  <joint name="fixed_joint1" type="fixed">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.0 0.0 .115" rpy="0 0 0"/>
  </joint>

  <link name="link4">
    <visual>
      <origin xyz=".05025 0 0" rpy="0 0 0"/>
      <geometry>
        <box size = "0.105 0.045 0.03"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint3" type="revolute">
  <parent link="link3"/>
  <child link="link4"/>
  <axis xyz="0 1 0"/>
  <limit effort="1000.0" lower="0.703" upper="3.118" velocity="0.5"/>
  <origin xyz="0.06 0 0" rpy="0 3.14159 0"/>
</joint>

<link name="link5">
    <visual>
      <origin xyz=".03025 0 0" rpy="0 0 0"/>
      <geometry>
        <box size = "0.065 0.04 0.04"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint4" type="revolute">
  <parent link="link4"/>
  <child link="link5"/>
  <axis xyz="0 1 0"/>
  <limit effort="1000.0" lower="0.712" upper="3.557" velocity="0.5"/>
  <origin xyz="0.105 0 0" rpy="0 3.14159 0"/>
</joint>


</robot>


  
