<?xml version="1.0"?>
<robot name="arm_robot">
  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size = "0.08 0.13 0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <geometry>
        <box size = "0.035 0.04 0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint1" type="continuous">
  <parent link="base_link"/>
  <child link="link1"/>
  <axis xyz="0 0 1"/>
  <origin xyz="0 0 0.05"/>
</joint>



  <link name="link2">
    <visual>
      <geometry>
        <box size = "0.03 0.045 0.115"/>
      </geometry>
    </visual>
  </link>

  <joint name="joint2" type="revolute">
  <axis xyz="1 0 0"/>
  <limit effort="1000.0" lower="1.372" upper="2.667" velocity="0.5"/>
  <origin rpy="0 0 0" xyz="0 0 .05"/>
  <parent link="link1"/>
  <child link="link2"/>
</joint>

<link name="link3">
    <visual>
      <geometry>
        <box size = "0.03 0.04 0.115"/>
      </geometry>
    </visual>
  </link>


<joint name="joint3" type="revolute">
  <axis xyz="1 0 0"/>
  <limit effort="1000.0" lower="0.703" upper="3.118" velocity="0.5"/>
  <origin rpy="1.5708 0 0" xyz="0 .1 -.05"/>
  <parent link="link2"/>
  <child link="link3"/>
  <pose relative_to="link2">0 0 0 0 0 0</pose relative_to>
</joint>

</robot>

